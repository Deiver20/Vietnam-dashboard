@import "tailwindcss";

@font-face {
  font-family: "pmzd";
  src: url("/font/pmzd.woff2") format("woff2");
}

:root {
  /* Navy */
  --color-navy-deep: #001730;
  --color-navy-darker: #030f1c;
  --color-navy-card: #0a2748;
  --color-navy-mid: #042038;
  --color-navy-line: #0f3160;

  /* Blue */
  --color-blue: #0066ff;
  --color-blue-2: #067aff;
  --color-blue-soft: #67a6ff;
  --color-blue-deep: #07074d;

  /* Green */
  --color-green: #33cc00;
  --color-green-2: #279b00;

  /* Yellow */
  --color-yellow: #fcb514;

  /* Red */
  --color-red: #f35959;

  /* Grays */
  --color-gray-1: #f1f1f1;
  --color-gray-2: #d8d8d8;
  --color-gray-3: #bfbfbf;
  --color-gray-4: #94959b;
  --color-gray-5: #686970;

  /* Base */
  --background: var(--color-navy-deep);
  --foreground: #ffffff;

  /* Radius */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-navy-deep: var(--color-navy-deep);
  --color-navy-darker: var(--color-navy-darker);
  --color-navy-card: var(--color-navy-card);
  --color-navy-mid: var(--color-navy-mid);
  --color-navy-line: var(--color-navy-line);
  --color-blue: var(--color-blue);
  --color-blue-2: var(--color-blue-2);
  --color-blue-soft: var(--color-blue-soft);
  --color-blue-deep: var(--color-blue-deep);
  --color-green: var(--color-green);
  --color-green-2: var(--color-green-2);
  --color-yellow: var(--color-yellow);
  --color-red: var(--color-red);
  --color-gray-1: var(--color-gray-1);
  --color-gray-2: var(--color-gray-2);
  --color-gray-3: var(--color-gray-3);
  --color-gray-4: var(--color-gray-4);
  --color-gray-5: var(--color-gray-5);
  --font-sans: var(--font-poppins);
  --font-mono: var(--font-jetbrains);
  --radius-sm: var(--radius-sm);
  --radius-md: var(--radius-md);
  --radius-lg: var(--radius-lg);
  --radius-xl: var(--radius-xl);
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-sans), Arial, Helvetica, sans-serif;
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--color-navy-darker);
}

::-webkit-scrollbar-thumb {
  background: var(--color-navy-line);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-blue-soft);
}

/* Text gradients */
.grad-blue {
  background: linear-gradient(135deg, #67a6ff 0%, #0066ff 60%, #2a84ff 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.grad-green {
  background: linear-gradient(135deg, #6ee85b 0%, #33cc00 60%, #279b00 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.grad-yellow {
  background: linear-gradient(135deg, #ffd55a 0%, #fcb514 60%, #e09a00 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Kicker */
.kicker {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-blue-soft);
}

.kicker::before {
  content: "";
  width: 20px;
  height: 2px;
  background: var(--color-blue-soft);
  border-radius: 2px;
}

/* Eyebrow */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-gray-2);
  backdrop-filter: blur(8px);
  margin-bottom: 28px;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 22px;
  border-radius: var(--radius-sm);
  font-weight: 500;
  font-size: 15px;
  transition: all 0.2s ease;
  white-space: nowrap;
  border: 1px solid transparent;
}
.btn--primary {
  background: var(--color-blue);
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(0, 102, 255, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.15);
}
.btn--primary:hover {
  background: var(--color-blue-2);
  box-shadow: 0 8px 24px rgba(0, 102, 255, 0.6);
  transform: translateY(-1px);
}
.btn--ghost {
  background: transparent;
  color: var(--color-gray-2);
  border: 1px solid rgba(255, 255, 255, 0.18);
}
.btn--ghost:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.3);
  color: #ffffff;
}
.btn--primary-sm,
.btn--ghost-sm {
  padding: 8px 16px;
  font-size: 13px;
}
.btn--primary-sm {
  background: var(--color-blue);
  color: white;
}
.btn--ghost-sm {
  color: var(--color-gray-2);
}
.btn--ghost-sm:hover {
  color: white;
}
.btn--lg {
  padding: 16px 28px;
  font-size: 16px;
}
.btn--block {
  display: flex;
  width: 100%;
  justify-content: center;
}

/* Hidden scrollbars */
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.scrollbar-none::-webkit-scrollbar {
  display: none;
}
.scrollbar-none {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Route-modal scroll area */
.modal-scroll {
  scrollbar-width: thin;
  scrollbar-color: rgba(0, 23, 48, 0.28) transparent;
}
.modal-scroll::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}
.modal-scroll::-webkit-scrollbar-track {
  background: transparent;
  margin: 16px 0;
}
.modal-scroll::-webkit-scrollbar-thumb {
  background: rgba(0, 23, 48, 0.25);
  border-radius: 8px;
}
.modal-scroll::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 23, 48, 0.4);
}

/* Dots */
.dot {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
}

.dot--green {
  background: var(--color-green);
  box-shadow: 0 0 8px var(--color-green);
  animation: pulseDot 2s ease-in-out infinite;
}

.dot--blue {
  background: var(--color-blue);
  box-shadow: 0 8px 8px var(--color-blue);
  animation: pulseDot 2s ease-in-out infinite;
}

/* ─── TRADE TABS (light mode) ─── */

.dashboard-light em.acc {
  font-style: italic;
  color: #03488D;
  font-weight: 500;
}

.dashboard-light .font-mono-numbers {
  font-family: var(--font-jetbrains), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

@keyframes pulseDot {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* ─── TRADE ROUTES MAP ─── */

.trade-route-flow {
  stroke-dashoffset: 0;
  animation-name: tradeRouteFlow;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes tradeRouteFlow {
  to {
    stroke-dashoffset: -7;
  }
}

@keyframes tradeHubPulse {
  0% {
    transform: scale(1);
    opacity: 0.35;
  }
  100% {
    transform: scale(3.4);
    opacity: 0;
  }
}
